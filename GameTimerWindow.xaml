<Window x:Class="RandomRec.GameTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomRec"
        Title="Random Recorder"
        Width="300" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Border x:Name="RootBorder"
            CornerRadius="14"
            Background="#0E0E0E"
            BorderBrush="#CC785C"
            BorderThickness="1.5"
            Margin="8"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.7" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>

        <Border.RenderTransform>
            <ScaleTransform x:Name="AppearScale" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="AppearScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.85" To="1" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="AppearScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.85" To="1" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,10">
            <TextBlock x:Name="TimerText"
                       Text="2:00"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="48"
                       FontWeight="Light"
                       Foreground="#EDE6DD"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DropHint"
                       Text="{x:Static local:GameText.DropHint}"
                       FontFamily="Times New Roman"
                       FontSize="13"
                       Foreground="#8A8178"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="250"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontFamily="Times New Roman"
                       FontSize="13"
                       Foreground="#E08966"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
