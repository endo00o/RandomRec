<Window x:Class="RandomRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RandomRec"
        xmlns:res="clr-namespace:RandomRec.Resources"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.WindowTitle}"
        Height="870" Width="620"
        MinHeight="620" MinWidth="520"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="10"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#2B2B2A"/>
        <SolidColorBrush x:Key="CardColor" Color="#363533"/>
        <SolidColorBrush x:Key="BorderColor" Color="#48464430"/>
        <SolidColorBrush x:Key="BorderColorHover" Color="#5C5A57"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F4ED"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A29A"/>
        <SolidColorBrush x:Key="Accent" Color="#CC785C"/>
        <SolidColorBrush x:Key="AccentHover" Color="#D8896F"/>
        <SolidColorBrush x:Key="AccentLight" Color="#3A2E2A"/>
        <SolidColorBrush x:Key="DangerColor" Color="#C25450"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderColorHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{StaticResource CardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource CardColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3E3C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C25450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{StaticResource BgColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Opacity="0.5"
                              BlurRadius="15"
                              ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Width="28" Height="28" Margin="0,0,10,0"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Click="IconButton_Click"
            WindowChrome.IsHitTestVisibleInChrome="True"
            ToolTip="About">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="/assets/randomrec.png" Width="22" Height="22"/>
                    </Button>
                    <TextBlock Text="{x:Static res:Strings.WindowTitle}"
               Foreground="{StaticResource TextPrimary}"
               FontSize="12"
               FontWeight="Medium"
               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"
                            Content="&#xE921;"/>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click"
                            Content="&#xE922;"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource CardColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static res:Strings.FolderLabel}"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="FolderTextBox" Text="C:\Records"/>
                                <Button Grid.Column="2"
                                        x:Name="BrowseButton"
                                        Content="{x:Static res:Strings.BrowseButton}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static res:Strings.IntervalLabel}"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="MinIntervalTextBox" Text="30"/>
                                <TextBlock Grid.Column="1" Text="—" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox Grid.Column="2" x:Name="MaxIntervalTextBox" Text="120"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static res:Strings.DurationLabel}"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="MinDurationTextBox" Text="30"/>
                                <TextBlock Grid.Column="1" Text="—" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox Grid.Column="2" x:Name="MaxDurationTextBox" Text="120"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="&#xE960;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static res:Strings.CameraLabel}"/>
                            </TextBlock>
                            <ComboBox x:Name="CameraComboBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static res:Strings.MicrophoneLabel}"/>
                            </TextBlock>
                            <ComboBox x:Name="MicrophoneComboBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="&#xF2B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static res:Strings.LanguageLabel}"/>
                            </TextBlock>
                            <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox x:Name="SilentModeCheckBox" Content="{x:Static res:Strings.SilentModeCheckbox}"/>
                            <CheckBox x:Name="ScreenshotsCheckBox" Content="{x:Static res:Strings.ScreenshotsCheckbox}" IsChecked="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#1A1A1A"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        MinHeight="260"
                        Margin="0,0,0,12">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>

                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="{x:Static res:Strings.PreviewPlaceholder}"
                                   Foreground="#555"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"/>

                        <Border x:Name="RecIndicator"
                                Background="#CC1A1A1A"
                                CornerRadius="6"
                                Padding="10,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="12"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource DangerColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static res:Strings.RecLabel}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button x:Name="StartButton"
                            Style="{StaticResource PrimaryButton}"
                            Width="140" Height="40" Margin="0,0,8,0"
                            Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconStyle}" Foreground="White"/>
                            <TextBlock Text="{x:Static res:Strings.StartButton}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton"
                            Style="{StaticResource DangerButton}"
                            Width="140" Height="40"
                            IsEnabled="False"
                            Click="StopButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource IconStyle}" Foreground="White"/>
                            <TextBlock Text="{x:Static res:Strings.StopButton}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="#1A1A1A"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="2"
                        Height="120">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Background="Transparent"
                             Foreground="#D4D4D4"
                             BorderThickness="0"
                             Padding="10"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
