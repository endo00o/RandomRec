<Window x:Class="RandomRec.GameOverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomRec"
        Title="Random Recorder"
        Height="380" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="GameBg" Color="#0E0E0E"/>
        <SolidColorBrush x:Key="GameAccent" Color="#CC785C"/>
        <SolidColorBrush x:Key="GameAccentBright" Color="#E08966"/>
        <SolidColorBrush x:Key="GameText" Color="#EDE6DD"/>
        <SolidColorBrush x:Key="GameTextDim" Color="#8A8178"/>
        <SolidColorBrush x:Key="GameCard" Color="#1C1C1C"/>
    </Window.Resources>

    <Border CornerRadius="14"
            Background="{StaticResource GameBg}"
            BorderBrush="#332B26"
            BorderThickness="1"
            Margin="12"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.7" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Border.RenderTransform>
            <ScaleTransform x:Name="AppearScale" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="AppearScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.85" To="1" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="AppearScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.85" To="1" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.35"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,20">

            <TextBlock Text="{x:Static local:GameText.OverTitle}"
                       FontFamily="Times New Roman"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{StaticResource GameAccent}"
                       HorizontalAlignment="Center"/>

            <Path Data="M0,8 C15,0 30,16 45,8 S75,0 90,8 S120,16 135,8 S165,0 180,8"
                  Stroke="{StaticResource GameAccent}"
                  StrokeThickness="2.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  HorizontalAlignment="Center"
                  Margin="0,4,0,18"
                  Opacity="0.9"/>

            <TextBlock FontFamily="Times New Roman"
                       FontSize="16"
                       Foreground="{StaticResource GameTextDim}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       Text="{x:Static local:GameText.OverDesc}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button Content="{x:Static local:GameText.PlayAgain}"
                        Click="PlayAgainButton_Click"
                        Width="160" Height="44"
                        Margin="0,0,12,0"
                        Foreground="White"
                        FontFamily="Times New Roman"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Background="{StaticResource GameAccent}"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="pb" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource GameAccentBright}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="#B5664C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="{x:Static local:GameText.BackToMain}"
                        Click="BackToMainButton_Click"
                        Width="180" Height="44"
                        Foreground="{StaticResource GameText}"
                        FontFamily="Times New Roman"
                        FontSize="17"
                        Cursor="Hand"
                        Background="{StaticResource GameCard}"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bb" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="#3A3A3A" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bb" Property="Background" Value="#262626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
