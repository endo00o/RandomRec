<Window x:Class="RandomRec.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RandomRec.Resources"
        Title="About"
        Height="500" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="10"
            Background="#2B2B2A"
            BorderBrush="#48464430"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <TextBlock Text="About"
                           Foreground="#A8A29A"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseAboutButton"
                        Width="46" Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#A8A29A"
                        BorderThickness="0"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="10"
                        Content="&#xE8BB;"
                        Cursor="Hand"
                        Click="CloseAboutButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="30,5,30,10" VerticalAlignment="Center">

                <!-- App section -->
                <Image Source="/assets/randomrec.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static res:Strings.WindowTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#F5F4ED"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="v1.0.0"
                           FontSize="11"
                           Foreground="#A8A29A"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,10"/>

                <TextBlock Text="Captures short random snippets of camera and microphone for life-logging or creative recording."
                           FontSize="12"
                           Foreground="#A8A29A"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"/>

                <!-- Divider -->
                <Border Height="1" Background="#48464430" Margin="0,5,0,15"/>

                <!-- Author section -->
                <TextBlock Text="Created by"
                           FontSize="10"
                           Foreground="#6B645C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Avatar with rounded corners -->
                <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border.Background>
                        <ImageBrush ImageSource="/assets/aboutmepfp.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <TextBlock Text="endo"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F5F4ED"
                           HorizontalAlignment="Center"/>

                <!-- Links row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock FontSize="12" Margin="0,0,12,0">
                        <Hyperlink NavigateUri="https://github.com/endo00o"
                                   RequestNavigate="Link_RequestNavigate"
                                   Foreground="#CC785C"
                                   TextDecorations="None">
                            <Run Text="GitHub"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#48464430" Margin="0,0,12,0">·</TextBlock>
                    <TextBlock FontSize="12">
                        <Hyperlink NavigateUri="https://t.me/endo0_0"
                                   RequestNavigate="Link_RequestNavigate"
                                   Foreground="#CC785C"
                                   TextDecorations="None">
                            <Run Text="Telegram"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="MIT License · © 2026"
                           FontSize="10"
                           Foreground="#6B645C"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>
            </StackPanel>

            <!-- Bottom button -->
            <Button Grid.Row="2"
                    x:Name="OkButton"
                    Content="Close"
                    Width="100" Height="32"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Background="#363533"
                    Foreground="#F5F4ED"
                    BorderBrush="#48464430"
                    BorderThickness="1"
                    Cursor="Hand"
                    FontSize="12"
                    Click="CloseAboutButton_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>